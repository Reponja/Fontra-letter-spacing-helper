{
  "name": "fontra-letter-spacing-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Spacing, kerning and tracking assistant for Fontra and UFO workflows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.plugin.config.ts",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "fontra",
    "font",
    "spacing",
    "kerning",
    "tracking",
    "type-design",
    "ufo"
  ],
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
